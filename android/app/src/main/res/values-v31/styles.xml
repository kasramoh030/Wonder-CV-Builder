<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later own the launch screen: the system paints it from the
     theme, so the brand colours and the mark are declared here rather than in
     the window background. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/brand_seed</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/canvas_light</item>
    </style>
</resources>
