<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon (Android 8+): the brand colour is the background layer and
    the page mark is the foreground, which keeps the icon legible behind every
    launcher mask. The monochrome layer feeds Android 13 themed icons.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/brand_seed" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
