<?xml version="1.0" encoding="utf-8"?>
<!-- The same policy as backup_rules.xml for Android 12+ (API 31), which
     splits cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="exports" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="exports" />
    </device-transfer>
</data-extraction-rules>
