<?xml version="1.0" encoding="utf-8"?>
<!--
    The window shown between tapping the icon and Flutter's first frame.
    A brand vertical gradient with the app mark centred, using only resources
    that exist in the repository (no generated artwork, no missing density).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/brand_seed"
                android:endColor="@color/brand_seed_deep"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
